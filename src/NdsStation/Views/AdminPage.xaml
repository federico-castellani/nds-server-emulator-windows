<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NdsStation.Views.AdminPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NdsStation.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="36,24,36,36" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Amministrazione" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Gestisci i giochi della libreria e gli account degli utenti."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Grid Margin="0,24,0,0" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Upload a game -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE898;" FontSize="18" />
                            <TextBlock Text="Carica un gioco" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBox x:Name="GameTitleBox" Header="Titolo" PlaceholderText="es. Pokémon Platino" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="ROM (.nds)" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RomPathBox" IsReadOnly="True" PlaceholderText="Nessun file selezionato" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Sfoglia…" Click="OnBrowseRom" />
                            </Grid>
                            <TextBlock Text="Senza file viene aggiunto solo il titolo." Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ProgressBar x:Name="UploadProgress" Visibility="Collapsed" Maximum="1" />
                        <Button x:Name="UploadButton" AutomationProperties.Name="Carica gioco" Style="{StaticResource AccentButtonStyle}" Click="OnUpload">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock x:Name="UploadButtonText" Text="Aggiungi titolo" />
                            </StackPanel>
                        </Button>
                        <InfoBar x:Name="UploadBar" IsClosable="True" />
                    </StackPanel>
                </Border>

                <!-- Create a user -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8FA;" FontSize="18" />
                            <TextBlock Text="Invita un utente" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBox x:Name="NewUserBox" Header="Nome utente" IsSpellCheckEnabled="False" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Password temporanea" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewPasswordBox" IsSpellCheckEnabled="False" FontFamily="Consolas" />
                                <Button Grid.Column="1" Content="Genera" Click="OnGeneratePassword" />
                            </Grid>
                            <TextBlock Text="Comunicala all'utente: potrà cambiarla dopo il primo accesso."
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Button x:Name="CreateUserButton" AutomationProperties.Name="Crea account" Style="{StaticResource AccentButtonStyle}" Click="OnCreateUser">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                <TextBlock Text="Crea account" />
                            </StackPanel>
                        </Button>
                        <InfoBar x:Name="CreateUserBar" IsClosable="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Users -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" Padding="0">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" FontSize="18" />
                            <TextBlock Text="Utenti" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="UserCountText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <AutoSuggestBox x:Name="UserSearchBox" Grid.Column="1" Width="220" PlaceholderText="Cerca utente"
                                        QueryIcon="Find" TextChanged="OnUserSearchChanged" />
                        <Button Grid.Column="2" Click="OnRefreshUsers" ToolTipService.ToolTip="Aggiorna" AutomationProperties.Name="Aggiorna utenti">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>

                    <InfoBar x:Name="UsersBar" IsClosable="True" Margin="20,0,20,12" />

                    <Grid Padding="20,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Nome utente" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Ruolo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Stato" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Azioni" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ProgressBar x:Name="UsersLoading" IsIndeterminate="True" Visibility="Collapsed" />

                    <ListView x:Name="UsersList" ItemsSource="{x:Bind Users}" SelectionMode="None" Padding="0,4,0,8">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="20,0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AdminUserItem">
                                <Grid Height="52" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind IdText}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <PersonPicture DisplayName="{x:Bind User.Username}" Width="28" Height="28" />
                                        <TextBlock Text="{x:Bind User.Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="(tu)" VerticalAlignment="Center" Visibility="{x:Bind SelfVisibility}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind RoleBackground}">
                                        <TextBlock Text="{x:Bind RoleText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind RoleForeground}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind StatusBackground}">
                                        <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind StatusForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Click="OnResetPassword" Tag="{x:Bind}" ToolTipService.ToolTip="Reimposta password" AutomationProperties.Name="Reimposta password">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                                <TextBlock Text="Reimposta" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnDeleteUser" Tag="{x:Bind}" IsEnabled="{x:Bind CanDelete}"
                                                ToolTipService.ToolTip="Elimina utente" AutomationProperties.Name="Elimina utente">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
