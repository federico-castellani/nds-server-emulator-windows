<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NdsStation.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- Restoring a saved session -->
        <StackPanel x:Name="RestorePanel" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock x:Name="RestoreText" Text="Accesso in corso…" HorizontalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <Button Content="Usa un altro account" HorizontalAlignment="Center" Click="OnCancelRestore" />
        </StackPanel>

        <!-- Sign-in form -->
        <ScrollViewer x:Name="FormPanel" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardBorderStyle}" Width="420" Padding="36,32"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE7FC;" FontSize="32" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="NDS Station" Style="{StaticResource TitleTextBlockStyle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Accedi al tuo account" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar x:Name="UpdateBar" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />

                    <TextBox x:Name="ServerBox" Header="Server" PlaceholderText="http://localhost:3000"
                             InputScope="Url" IsSpellCheckEnabled="False" KeyDown="OnFieldKeyDown" />
                    <TextBox x:Name="UsernameBox" Header="Nome utente" IsSpellCheckEnabled="False"
                             KeyDown="OnFieldKeyDown" />
                    <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="OnFieldKeyDown" />

                    <Button x:Name="SignInButton" AutomationProperties.Name="Accedi" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="OnSignIn">
                        <Grid>
                            <TextBlock x:Name="SignInText" Text="Accedi" />
                            <ProgressRing x:Name="SignInRing" IsActive="False" Width="16" Height="16"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
