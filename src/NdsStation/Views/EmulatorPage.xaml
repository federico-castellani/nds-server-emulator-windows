<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NdsStation.Views.EmulatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid x:Name="Toolbar" Padding="8,0,8,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource NavigationBackButtonNormalStyle}"
                        AllowFocusOnInteraction="False" Click="OnBack" AutomationProperties.Name="Torna alla libreria" ToolTipService.ToolTip="Torna alla libreria (salva sul server)" />
                <TextBlock x:Name="GameTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420" />
            </StackPanel>

            <StackPanel x:Name="StatusPanel" Grid.Column="1" Visibility="Collapsed" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <StackPanel x:Name="SyncPanel" Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="SyncIcon" Glyph="&#xE753;" FontSize="16" />
                    <TextBlock x:Name="SyncText" Text="Sincronizzato" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="FpsText" Text="— FPS" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MinWidth="56" />
            </StackPanel>

            <CommandBar x:Name="GameCommands" Grid.Column="2" Visibility="Collapsed" DefaultLabelPosition="Collapsed" Background="Transparent" IsDynamicOverflowEnabled="True"
                        OverflowButtonVisibility="Auto">
                <AppBarToggleButton x:Name="PauseButton" Label="Pausa (P)" ToolTipService.ToolTip="Pausa (P)"
                                    AllowFocusOnInteraction="False" Click="OnPauseClick">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE769;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="FastForwardButton" Label="Avanti veloce (Spazio)" ToolTipService.ToolTip="Avanti veloce (tieni premuto Spazio)"
                                    AllowFocusOnInteraction="False">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xEB9D;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton x:Name="VolumeButton" Label="Volume" ToolTipService.ToolTip="Volume" AllowFocusOnInteraction="False">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE767;" FontSize="16" />
                                <Slider x:Name="VolumeSlider" Width="180" Minimum="0" Maximum="100" StepFrequency="1"
                                        ValueChanged="OnVolumeChanged" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Stati salvati" ToolTipService.ToolTip="Stati salvati (F5 salva, F8 carica)" AllowFocusOnInteraction="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="StatesMenu" Placement="Bottom" Opening="OnStatesMenuOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Disposizione schermi" ToolTipService.ToolTip="Disposizione schermi" AllowFocusOnInteraction="False">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <RadioMenuFlyoutItem x:Name="LayoutVertical" Text="Verticale" GroupName="layout" Click="OnLayoutClick" Tag="Vertical" />
                            <RadioMenuFlyoutItem x:Name="LayoutHorizontal" Text="Affiancati" GroupName="layout" Click="OnLayoutClick" Tag="Horizontal" />
                            <RadioMenuFlyoutItem x:Name="LayoutTopFocus" Text="Superiore grande" GroupName="layout" Click="OnLayoutClick" Tag="TopFocus" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="IntegerScalingItem" Text="Scala intera" Click="OnIntegerScalingClick" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="FullScreenButton" Label="Schermo intero (F11)" ToolTipService.ToolTip="Schermo intero (F11)"
                              AllowFocusOnInteraction="False" Click="OnFullScreenClick">
                    <AppBarButton.Icon>
                        <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <!-- Screens -->
        <Grid x:Name="ScreenArea" Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <canvas:CanvasControl x:Name="Canvas"
                                  ClearColor="Transparent"
                                  CreateResources="OnCreateResources"
                                  Draw="OnDraw"
                                  PointerPressed="OnPointerPressed"
                                  PointerMoved="OnPointerMoved"
                                  PointerReleased="OnPointerReleased"
                                  PointerCanceled="OnPointerReleased"
                                  PointerCaptureLost="OnPointerReleased" />

            <!-- Loading / syncing overlay -->
            <Border x:Name="Overlay" Style="{StaticResource CardBorderStyle}" Width="380" Padding="28,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="OverlayTitle" Text="Preparazione del gioco" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="OverlayText" Text="Download della ROM…" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="OverlayProgress" IsIndeterminate="True" Maximum="1" />
                    <Button x:Name="OverlayCancel" Content="Annulla" HorizontalAlignment="Right" Click="OnCancelLoading" />
                </StackPanel>
            </Border>

            <!-- Paused badge -->
            <Border x:Name="PausedBadge" Visibility="Collapsed" Style="{StaticResource CardBorderStyle}" Padding="16,8"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                    <TextBlock Text="In pausa · premi P per riprendere" />
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <InfoBar x:Name="Toast" IsClosable="True" MaxWidth="520" Margin="16"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</Page>
