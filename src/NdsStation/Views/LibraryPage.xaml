<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NdsStation.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NdsStation.Views">

    <Grid Padding="36,24,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Libreria" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="280" VerticalAlignment="Center"
                            PlaceholderText="Cerca un gioco" QueryIcon="Find" TextChanged="OnSearchChanged" />
            <Button Grid.Column="2" VerticalAlignment="Center" Click="OnRefresh" ToolTipService.ToolTip="Aggiorna" AutomationProperties.Name="Aggiorna">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="0,16,0,0" Severity="Error" IsClosable="True">
            <InfoBar.ActionButton>
                <Button Content="Riprova" Click="OnRefresh" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False" Width="40" Height="40" />

        <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE7FC;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="EmptyText" Text="Nessun gioco disponibile" HorizontalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <GridView x:Name="GamesGrid" Grid.Row="2" Margin="-6,20,-6,0" Padding="0,0,0,36"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnGameClick"
                  ItemsSource="{x:Bind Games}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:GameItem">
                    <Grid Width="196" Height="236" CornerRadius="{StaticResource OverlayCornerRadius}"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="148" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Gioca" Click="OnPlayMenu" Tag="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Rimuovi dalla cache" Click="OnRemoveFromCache" Tag="{x:Bind}"
                                                IsEnabled="{x:Bind IsCached, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Border Background="{x:Bind CoverBrush}">
                            <Grid>
                                <TextBlock Text="{x:Bind Initials}" FontSize="44" FontWeight="SemiBold" Opacity="0.9"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{x:Bind ShowInitials, Mode=OneWay}" />
                                <Border Width="96" Height="96" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#33FFFFFF" Visibility="{x:Bind ShowIcon, Mode=OneWay}">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="96" Height="96" />
                                </Border>
                                <Border Visibility="{x:Bind CachedVisibility, Mode=OneWay}" Background="#66000000"
                                        CornerRadius="4" Padding="6,2" Margin="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        ToolTipService.ToolTip="Disponibile offline">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Padding="14,10,14,12" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
